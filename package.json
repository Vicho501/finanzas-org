{
  "name": "finanzas-org",
  "version": "0.1.0",
  "description": "Sistema de gestión financiera para organizaciones - App desktop local",
  "main": "dist/main/index.js",
  "author": "Vicho501",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc --project tsconfig.node.json && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && tsc --project tsconfig.node.json && electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:main && electron-builder",
    "lint": "eslint src --ext ts,tsx",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.finanzasorg.app",
    "productName": "FinanzasOrg",
    "directories": { "output": "release" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" }
  }
}
